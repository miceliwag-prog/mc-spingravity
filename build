name: build
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - id: root
        run: echo "dir=$(dirname "$(find . -name settings.gradle -not -path './.git/*' | head -n1)")" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 25
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 9.6.0
      - run: gradle build --console=plain
        working-directory: ${{ steps.root.outputs.dir }}
      - uses: actions/upload-artifact@v4
        with:
          name: spingravity-jar
          path: ${{ steps.root.outputs.dir }}/build/libs/*.jar
